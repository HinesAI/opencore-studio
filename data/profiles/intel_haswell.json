  "mandatorySsdt": [
    {"name": "SSDT-PLUG.aml", "reason": "CPU power management."},
    {"name": "SSDT-EC.aml", "reason": "Fake Embedded Controller on desktops that lack a usable EC."}
  ],
  "recommendedKexts": ["Lilu", "VirtualSMC", "SMCProcessor", "SMCSuperIO", "WhateverGreen", "AppleALC", "IntelMausi", "USBToolBox", "UTBMap"],
